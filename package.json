{
  "name": "cli-in-wechat",
  "version": "0.1.0",
  "description": "Use WeChat to run local AI CLIs, LAN agents, and archive files to NAS via iLink Bot API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cli-in-wechat": "dist/index.js",
    "wcli": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:debug": "tsx src/index.ts --debug",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.81",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "wechat",
    "clawbot",
    "ilink",
    "ai-agent",
    "codex",
    "claude",
    "nas",
    "lan"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lenlanF/cli-in-wechat.git"
  },
  "bugs": {
    "url": "https://github.com/lenlanF/cli-in-wechat/issues"
  },
  "homepage": "https://github.com/lenlanF/cli-in-wechat#readme",
  "license": "MIT"
}
